generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String
  material    String
  price       Int
  description String
  image       String
  isFeatured  Boolean  @default(false)
  stock       Int      @default(3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  orderItems  OrderItem[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  tier      String   @default("Oro")
  spent     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  orders    Order[]
}

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  status      String   @default("Procesando")
  payment     String   @default("Stripe")
  totalAmount Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  
  items       OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int
  priceAtPurchase Int 
  
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

model StoreSettings {
  id              String   @id @default("singleton")
  storeName       String   @default("Lumina Joyas")
  whatsappNumber  String   @default("+52 81 1234 5678")
  checkoutMessage String   @default("Garantizamos absoluta discreción y seguridad blindada en su entrega.")
  stripeSecretKey String   @default("")
  paypalClientId  String   @default("")
  payIdEmail      String   @default("payments@luminajewelry.com.au")
  smtpProvider    String   @default("")
  twilioSid       String   @default("")
  twilioToken     String   @default("")
  termsText       String   @default("")
  privacyText     String   @default("")
  returnsText     String   @default("")
  updatedAt       DateTime @updatedAt
}
